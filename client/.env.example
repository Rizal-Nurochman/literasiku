# ======================================
# Application
# ======================================

# Application environment (development | production | test)
NODE_ENV=development

# ======================================
# Logging
# ======================================

# Log level for pino logger (trace, debug, info, warn, error, fatal)
LOG_LEVEL=info

# ======================================
# Backend API (Go Server)
# ======================================

# Base URL of the Go backend API
NUXT_GO_API_BASE_URL=http://localhost:8080

# Internal API key for server-to-server communication with Go backend
NUXT_GO_INTERNAL_API_KEY=

# ======================================
# Pinecone Vector Database
# ======================================

# Pinecone API key for vector database access
NUXT_PINECONE_API_KEY=

# Pinecone index name (must exist, not created at runtime)
NUXT_PINECONE_INDEX_NAME=literasiku

# Pinecone namespace for document/library vectors
NUXT_PINECONE_NAMESPACE=default

# ======================================
# RAG (Retrieval-Augmented Generation)
# ======================================

# Minimum similarity score for RAG results (0.0 - 1.0)
NUXT_RAG_MIN_SCORE=0.3

# Maximum number of RAG references to retrieve per query
NUXT_RAG_MAX_REFERENCES=8

# ======================================
# Deployment (Nitro Server)
# ======================================

# Port for the Nitro server (used in Docker/production)
PORT=3000

# Host for the Nitro server (used in Docker/production)
HOST=0.0.0.0
