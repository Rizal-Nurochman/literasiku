# ======================================
# Application
# ======================================
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# ======================================
# Logging
# ======================================
LOG_LEVEL=info

# ======================================
# Backend API (Go Server)
# ======================================
NUXT_GO_API_BASE_URL=http://localhost:8080
NUXT_GO_INTERNAL_API_KEY=

# ======================================
# Pinecone Vector Database
# ======================================
NUXT_PINECONE_API_KEY=
NUXT_PINECONE_INDEX_NAME=literasiku
NUXT_PINECONE_NAMESPACE=default

# ======================================
# RAG (Retrieval-Augmented Generation)
# ======================================
NUXT_RAG_MIN_SCORE=0.3
NUXT_RAG_MAX_REFERENCES=8

# ======================================
# LLM Provider (Flaz API - OpenAI Compatible)
# ======================================
FLAZ_BASE_URL=https://ai.flaz.id/v1
FLAZ_API_KEY=
LLM_MODEL=MiniMax-M2.7-highspeed
HUGGINGFACE_API_KEY=
