# ==========================================
# Application
# ==========================================

PORT=8080
APP_ENV=development

# ==========================================
# Database
# ==========================================

# Gunakan DATABASE_URL untuk koneksi langsung (Vercel + Neon/Supabase)
# Contoh: postgres://user:password@host:5432/dbname?sslmode=require
# DATABASE_URL=

# Atau gunakan field terpisah (local development)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=literasiku_db
DB_SSLMODE=disable
DB_TIMEZONE=Asia/Jakarta

# ==========================================
# JWT
# ==========================================

# Wajib diisi. Jangan gunakan default.
JWT_SECRET=change-this-secret

# ==========================================
# ImageKit (File Upload)
# ==========================================

# Wajib diisi untuk mengaktifkan upload file.
IMAGEKIT_PRIVATE_KEY=

# ==========================================
# Fine
# ==========================================

# Denda per hari keterlambatan fisik (dalam Rupiah)
FINE_RATE_PER_DAY=1000
