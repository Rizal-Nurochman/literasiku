PORT=8080

APP_ENV=development

# Pilih salah satu cara set DB:
# Cara 1: pakai DATABASE_URL (rekomendasi untuk Vercel + Neon/Supabase)
# DATABASE_URL=postgres://user:password@host:5432/dbname?sslmode=require

# Cara 2: pakai field terpisah (untuk local Postgres)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=literasiku_db
DB_SSLMODE=disable
DB_TIMEZONE=Asia/Jakarta

JWT_SECRET=