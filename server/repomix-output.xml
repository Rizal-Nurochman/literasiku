<file path="cmd/api/main.go">
package main

import (
	"log"
	"os"

	"github.com/literasiKu/internal/router"
)

func main() {
	port := os.Getenv("PORT")
	if port == "" {
		port = "8080"
	}

	app := router.New()

	if err := app.Run(":" + port); err != nil {
		log.Fatalf("failed to start server: %v", err)
	}
}
</file>

